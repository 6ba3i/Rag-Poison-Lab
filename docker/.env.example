# Image pins / defaults
ELASTICSEARCH_IMAGE=elasticsearch:8.19.11
KIBANA_IMAGE=kibana:8.19.11
OLLAMA_IMAGE=ollama/ollama:latest

# Bind mount roots
HOST_DATA_DIR=./data
HOST_ML100_DIR=./ml-100

# Default provider/model selections (no secrets here)
VICTIM_PROVIDER=local
VICTIM_MODEL=qwen2.5:1.5b
ATTACKER_PROVIDER=local
ATTACKER_MODEL=qwen2.5:1.5b

# Default local Ollama model to bootstrap on compose up
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
