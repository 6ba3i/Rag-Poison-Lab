# Core service URLs (host-run defaults; compose containers override ELASTICSEARCH_URL)
ELASTICSEARCH_URL=http://localhost:9200
OLLAMA_BASE_URL=http://localhost:11434

# Shared OpenAI-compatible gateway (optional transit config)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Provider-specific overrides (preferred when set)
CHATGPT_BASE_URL=
CHATGPT_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_API_KEY=
GEMINI_BASE_URL=
GEMINI_API_KEY=
QWEN_BASE_URL=
QWEN_API_KEY=

# Deprecated fallback (legacy Docker secret file paths; keep only during migration)
CHATGPT_API_KEY_FILE=/run/secrets/chatgpt_api_key
CLAUDE_API_KEY_FILE=/run/secrets/claude_api_key
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
QWEN_API_KEY_FILE=/run/secrets/qwen_api_key
